---
import { Phone, CheckCircle2, Star, ChevronRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/forms/QuoteForm.astro';
import { site, services, locations, getService, reviews } from '../../data/site';
import { absoluteAsset, absoluteUrl, breadcrumbSchema } from '../../lib/seo';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
  }));
}

const { slug } = Astro.params;
const service = getService(slug!);

if (!service) {
  return Astro.redirect('/404/');
}

const serviceReviews = reviews.slice(0, 2);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': absoluteUrl(`/services/${service.slug}/`),
  name: service.title,
  serviceType: service.title,
  description: service.description,
  image: absoluteAsset(service.image),
  url: absoluteUrl(`/services/${service.slug}/`),
  provider: {
    '@type': 'HomeAndConstructionBusiness',
    '@id': `${site.url}/#business`,
    name: site.name,
    telephone: site.phoneTel,
    url: `${site.url}/`,
  },
  areaServed: locations.map((l) => ({
    '@type': 'City',
    name: `${l.city}, FL`,
  })),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    description: 'Free on-site estimate',
  },
};

const crumbs = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: service.title, path: `/services/${service.slug}/` },
]);

const title = `${service.title} in Plant City, FL & Tampa Bay | ${site.shortName}`;
const description = `${service.hook} Free estimates. ${site.credentials.insurance}. Call ${site.phone}.`;
---

<BaseLayout title={title} description={description} schema={[serviceSchema, crumbs]} preloadImage={service.image}>
  <section class="bg-[#1C1D17] text-[#EEEDEA] py-20 lg:py-32 relative overflow-hidden">
    <div class="absolute inset-0 opacity-30">
      <img
        src={service.image}
        alt={service.title}
        class="w-full h-full object-cover"
        width="1600"
        height="900"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-[#1C1D17]/80"></div>
    </div>
    <div class="container-site relative z-10">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-primary font-bold uppercase tracking-wider mb-4 text-sm">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <ChevronRight class="h-4 w-4" />
          <a href="/services/" class="hover:text-white transition-colors">Services</a>
          <ChevronRight class="h-4 w-4" />
          <span class="text-white">{service.title}</span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-heading mb-6 text-white">
          {service.title} in Plant City, FL & Tampa Bay
        </h1>
        <p class="text-xl lg:text-2xl text-white/90 font-medium mb-8">{service.hook}</p>
        <a href={`tel:${site.phoneTel}`} class="btn btn-lg btn-primary">
          <Phone class="h-5 w-5" /> Get a Free Estimate
        </a>
      </div>
    </div>
  </section>

  <div class="container-site py-16 lg:py-24">
    <div class="grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 space-y-12">
        <section>
          <h2 class="text-3xl font-heading mb-4">What is {service.title}?</h2>
          <p class="text-lg text-muted-foreground leading-relaxed">{service.description}</p>
        </section>

        <section class="bg-muted p-8 rounded-xl">
          <h2 class="text-2xl font-heading mb-6">Signs You Need This Service</h2>
          <ul class="grid sm:grid-cols-2 gap-4">
            {
              service.signs.map((sign) => (
                <li class="flex items-start gap-3">
                  <CheckCircle2 class="h-6 w-6 text-primary shrink-0" />
                  <span class="font-medium">{sign}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2 class="text-3xl font-heading mb-6">How Our Process Works</h2>
          <div class="space-y-6">
            {
              service.process.map((step, idx) => (
                <div class="flex gap-4">
                  <div class="w-12 h-12 rounded-full bg-primary text-primary-foreground flex items-center justify-center font-heading text-xl shrink-0">
                    {idx + 1}
                  </div>
                  <div>
                    <h3 class="text-xl font-bold mb-2 normal-case tracking-normal">{step.title}</h3>
                    <p class="text-muted-foreground">{step.text}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <section>
          <h2 class="text-3xl font-heading mb-4">What Affects the Price?</h2>
          <p class="text-lg text-muted-foreground leading-relaxed mb-4">{service.priceFactors}</p>
          <a
            href="/pricing/tree-removal-cost-plant-city/"
            class="text-primary font-bold hover:underline"
          >
            See our full pricing guide →
          </a>
        </section>

        <section>
          <h2 class="text-3xl font-heading mb-6">What Our Clients Say</h2>
          <div class="grid sm:grid-cols-2 gap-6">
            {
              serviceReviews.map((review) => (
                <div class="bg-card border border-border p-6 rounded-xl shadow-sm">
                  <div class="flex gap-1 text-yellow-400 mb-3">
                    {[1, 2, 3, 4, 5].map(() => <Star class="fill-current h-4 w-4" />)}
                  </div>
                  <p class="mb-4 italic">"{review.text}"</p>
                  <p class="font-bold font-heading normal-case tracking-normal">
                    {review.name} — {review.city}
                  </p>
                </div>
              ))
            }
          </div>
        </section>

        <section class="bg-card border border-border rounded-xl p-8">
          <h2 class="text-2xl font-heading mb-4">Next Step Based on Your Situation</h2>
          <ul class="space-y-3 text-muted-foreground">
            <li>
              Need it done in your city?
              <a href="/areas/plant-city/" class="text-primary font-semibold hover:underline"
                >Check service areas</a
              >
            </li>
            <li>
              Comparing companies?
              <a
                href="/compare/local-vs-national-tree-service/"
                class="text-primary font-semibold hover:underline">Local vs national</a
              >
            </li>
            <li>
              Not sure if it's urgent?
              <a
                href="/problems/leaning-tree-vs-storm-damage/"
                class="text-primary font-semibold hover:underline">Problem guide</a
              >
            </li>
          </ul>
        </section>
      </div>

      <div class="space-y-8">
        <QuoteForm source={`service-${service.slug}`} />

        <div class="bg-[#3B7543] text-white p-8 rounded-xl shadow-lg">
          <h3 class="text-2xl font-heading mb-4 text-white">Areas We Serve</h3>
          <ul class="space-y-3 font-semibold">
            {
              locations.slice(0, 5).map((area) => (
                <li>
                  <a
                    href={`/areas/${area.slug}/`}
                    class="hover:text-primary transition-colors flex items-center gap-2"
                  >
                    <ChevronRight class="h-4 w-4 text-primary" /> {area.city}
                  </a>
                </li>
              ))
            }
          </ul>
          <a href="/areas/" class="btn btn-md btn-ghost-light w-full mt-6">View All Areas</a>
        </div>
      </div>
    </div>
  </div>

  <section class="py-20 bg-primary text-primary-foreground text-center">
    <div class="container-site">
      <h2 class="text-4xl lg:text-5xl font-heading mb-6">NEED {service.title.toUpperCase()}?</h2>
      <p class="text-xl mb-8 text-white/90 font-medium">Call today for a FREE ESTIMATE.</p>
      <a href={`tel:${site.phoneTel}`} class="btn btn-xl btn-dark">
        <Phone class="h-6 w-6" />
        {site.phone}
      </a>
    </div>
  </section>
</BaseLayout>
