---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, services } from '../../data/site';
---

<BaseLayout
  title={`Tree Services in Plant City & Tampa Bay | ${site.shortName}`}
  description="Tree removal, trimming, emergency storm damage, stump grinding, and more. Free estimates. 24/7 emergency response."
>
  <section class="bg-[#1C1D17] text-[#EEEDEA] py-20">
    <div class="container-site text-center">
      <h1 class="text-4xl lg:text-6xl font-heading mb-6 text-white">OUR TREE SERVICES</h1>
      <p class="text-xl text-white/90 max-w-2xl mx-auto">
        One service page per job type — so you can find exactly what you need.
      </p>
    </div>
  </section>

  <section class="py-20">
    <div class="container-site">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          services.map((service) => (
            <a
              href={`/services/${service.slug}/`}
              class="bg-card rounded-xl overflow-hidden shadow-lg border border-border group hover:border-primary transition-colors"
            >
              <div class="h-48 overflow-hidden">
                <img
                  src={service.image}
                  alt={service.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  width="400"
                  height="192"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="p-6">
                <h2 class="text-2xl font-heading mb-3">{service.title}</h2>
                <p class="text-muted-foreground mb-4">{service.shortDescription}</p>
                <span class="text-primary font-bold">Learn more →</span>
              </div>
            </a>
          ))
        }
      </div>

      <div class="mt-16 bg-muted rounded-xl p-8 md:p-12 text-center">
        <h2 class="text-3xl font-heading mb-4">Need Help Choosing?</h2>
        <p class="text-muted-foreground mb-6 max-w-2xl mx-auto">
          Start with the question you're asking right now — cost, urgency, or who to hire.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/pricing/tree-removal-cost-plant-city/" class="btn btn-md btn-outline">Pricing</a>
          <a href="/problems/leaning-tree-vs-storm-damage/" class="btn btn-md btn-outline"
            >Is it urgent?</a
          >
          <a href="/contact/" class="btn btn-md btn-primary">Get a Free Estimate</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
