---
import { Phone } from '@lucide/astro';
import { site } from '../../data/site';
---

<div
  class="lg:hidden fixed bottom-0 left-0 w-full bg-background border-t border-border p-3 pb-6 flex gap-2 z-50 shadow-[0_-10px_20px_rgba(0,0,0,0.15)]"
>
  <a href={`tel:${site.phoneTel}`} class="btn btn-md btn-primary flex-1 h-12 text-base">
    <Phone class="w-4 h-4" />
    Call Now
  </a>
  <a href="/contact" class="btn btn-md btn-dark flex-1 h-12 text-base">Request Quote</a>
</div>
